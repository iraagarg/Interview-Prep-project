# ── Required ───────────────────────────────────────────────
PORT=5001
NODE_ENV=development
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/interviewai locally)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interviewai
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

# ── AI (optional: without a key the app uses rule-based fallbacks) ──
GROQ_API_KEY=
# Model IDs are configurable so a retired model is a config change, not a code change
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Resume storage (optional locally; required in production) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
